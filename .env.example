# Example environment variables for RGB-Fighters
# Copy to `.env` and fill values for local dev

# For production use a Postgres-compatible DATABASE_URL (e.g. Supabase)
# Example: postgres://user:password@db.host:5432/rgb_fighters
DATABASE_URL=

# JWT secret used for signing socket and HTTP auth tokens
JWT_SECRET=change-me-to-a-strong-secret

# Frontend URL for CORS and redirects
FRONTEND_URL=http://localhost:5173

# Use SQLite only for local dev. Set to 1 to force SQLite.
USE_SQLITE=1

# Optionally set the sqlite DB file path
SQLITE_DB_FILE=server/db.sqlite
